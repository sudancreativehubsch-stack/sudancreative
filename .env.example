# =====================================================================
# Sudan Creative Hub: environment variables
# Copy this file to .env.local and fill it in.
# Lines starting with # are comments. Do not put comments after a value.
# Names starting NEXT_PUBLIC_ are baked in at build time.
# SECRET values are pushed to Cloudflare by scripts/set-secrets.sh
# =====================================================================

# Public site address (SEO, sitemap, WhatsApp messages). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://sudancreativehub.com

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET: server only, never share
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 media storage (images, videos, PDFs) ---
# Public base URL of the bucket, no trailing slash (r2.dev URL or media.yourdomain.com)
NEXT_PUBLIC_MEDIA_URL=
R2_ACCOUNT_ID=
R2_BUCKET=sudan-creative-hub-media
# SECRET
R2_ACCESS_KEY_ID=
# SECRET
R2_SECRET_ACCESS_KEY=

# --- Contact form email (Resend) ---
# SECRET
RESEND_API_KEY=
RESEND_FROM=Sudan Creative Hub <onboarding@resend.dev>
CONTACT_TO_EMAIL=sudancreativehubsch@gmail.com

# --- Spam protection (Cloudflare Turnstile) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# SECRET
TURNSTILE_SECRET_KEY=
# SECRET: any long random string
IP_HASH_SALT=

# --- Analytics and Search Console (optional) ---
# Example: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# The content="..." value of the Google Search Console verification meta tag
NEXT_PUBLIC_GSC_VERIFICATION=
